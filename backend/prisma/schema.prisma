generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ENUMS


enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum PaperStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Grade {
  O
  A_PLUS
  A
  B_PLUS
  B
  C
  F
}

enum PatternMode {
  BOARD
  CUSTOM
}

enum QuestionType {
  MCQ
  VERY_SHORT
  SHORT
  LONG
}

enum SourceType {
  TEXTBOOK
  CHAPTER_NOTES
  TEACHER_NOTES
  QUESTION_GLOSSARY
  QUESTION_BANK
  PREVIOUS_BOARD_PAPER
  SAMPLE_PAPER
  REFERENCE_MATERIAL
  STUDY_MATERIAL
  OTHER
}

enum SourceStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
  DISABLED
}

// USER MODELS


model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  dob       DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher   Teacher?
  student   Student?
}

model Teacher {
  id                String   @id @default(uuid())
  userId            String   @unique
  education         String
  experienceYears   Int      // renamed for clarity

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User             @relation(fields: [userId], references: [id])
  questionPapers    QuestionPaper[]
  students          TeacherStudent[]
  examResults       ExamResult[]
  customPatterns    CustomPattern[]
}

model Student {
  id        String   @id @default(uuid())
  userId    String   @unique
  uniqueId  String   @unique
  contact   String
  classId   String
  streamId  String   //direct stream reference

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  class           Class            @relation(fields: [classId], references: [id])
  stream          Stream           @relation(fields: [streamId], references: [id])
  teachers        TeacherStudent[]
  examResults     ExamResult[]
  semesterResults SemesterResult[]
}

// MANY TO MANY RELATION


model TeacherStudent {
  id         String   @id @default(uuid())
  teacherId  String
  studentId  String
  assignedAt DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([teacherId, studentId])
}

// CLASS MODEL


// ACADEMIC HIERARCHY & CURRICULUM

model Board {
  id        String   @id @default(uuid())
  name      String   @unique // e.g. "Maharashtra State Board"
  code      String   @unique // e.g. "MSBSHSE"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  streams           Stream[]
  classes           Class[]
  knowledgeSources  KnowledgeSource[]
  chapterWeightages ChapterWeightage[]
}

model Class {
  id           String   @id @default(uuid())
  name         String   // "11th Standard", "12th Standard"
  academicYear String   @default("2026-2027")
  streamId     String?
  boardId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stream            Stream?            @relation(fields: [streamId], references: [id])
  board             Board?             @relation(fields: [boardId], references: [id])
  classSubjects     ClassSubject[]
  students          Student[]
  knowledgeSources  KnowledgeSource[]
  chapterWeightages ChapterWeightage[]

  @@unique([name, academicYear, streamId]) 
}

model Stream {
  id      String  @id @default(uuid())
  name    String  // "Science", "Commerce", "Arts"
  boardId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board             Board?             @relation(fields: [boardId], references: [id])
  classes           Class[]
  subjects          Subject[]
  students          Student[]
  knowledgeSources  KnowledgeSource[]
  chapterWeightages ChapterWeightage[]

  @@unique([name, boardId])
}

model Subject {
  id       String  @id @default(uuid())
  name     String
  code     String?
  streamId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stream            Stream             @relation(fields: [streamId], references: [id])
  classSubjects     ClassSubject[]
  units             Unit[]
  chapters          Chapter[]
  questionPapers    QuestionPaper[]
  knowledgeSources  KnowledgeSource[]
  chapterWeightages ChapterWeightage[]
  diagrams          DiagramRegistry[]

  @@unique([name, streamId])
}

model ClassSubject {
  id        String @id @default(uuid())
  classId   String
  subjectId String

  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([classId, subjectId])
}

model Unit {
  id        String @id @default(uuid())
  name      String
  order     Int    @default(1)
  subjectId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject           Subject            @relation(fields: [subjectId], references: [id])
  chapters          Chapter[]
  knowledgeSources  KnowledgeSource[]
  chapterWeightages ChapterWeightage[]

  @@unique([name, subjectId])
}

model Chapter {
  id        String  @id @default(uuid())
  chapterNo Int?
  name      String
  subjectId String
  unitId    String?
  pageStart Int?
  pageEnd   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject           Subject            @relation(fields: [subjectId], references: [id])
  unit              Unit?              @relation(fields: [unitId], references: [id])
  topics            Topic[]
  questions         Question[]
  knowledgeSources  KnowledgeSource[]
  chapterWeightages ChapterWeightage[]
  diagrams          DiagramRegistry[]

  @@unique([name, subjectId])
}

model Topic {
  id        String  @id @default(uuid())
  topicNo   String?
  name      String
  chapterId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapter          Chapter           @relation(fields: [chapterId], references: [id])
  questions        Question[]
  knowledgeSources KnowledgeSource[]
  diagrams         DiagramRegistry[]

  @@unique([name, chapterId])
}

model ChapterWeightage {
  id              String  @id @default(uuid())
  boardId         String?
  streamId        String?
  classId         String?
  subjectId       String
  unitId          String?
  chapterId       String?
  marks           Int     // Prescribed marks without option
  marksWithOption Int     // Prescribed marks with option

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board   Board?   @relation(fields: [boardId], references: [id])
  stream  Stream?  @relation(fields: [streamId], references: [id])
  class   Class?   @relation(fields: [classId], references: [id])
  subject Subject  @relation(fields: [subjectId], references: [id])
  unit    Unit?    @relation(fields: [unitId], references: [id])
  chapter Chapter? @relation(fields: [chapterId], references: [id])
}

model KnowledgeSource {
  id             String       @id @default(uuid())
  title          String
  sourceType     SourceType   @default(TEXTBOOK)
  fileName       String
  filePath       String
  fileSize       Int?
  status         SourceStatus @default(PROCESSED)
  uploadedBy     String       // User ID
  description    String?
  boardId        String?
  streamId       String?
  classId        String?
  subjectId      String?
  unitId         String?
  chapterId      String?
  topicId        String?
  pageStart      Int?
  pageEnd        Int?
  driveFileId    String?      // Authoritative Google Drive reference
  driveFolderId  String?
  mimeType       String?
  fileUrl        String?      // Optional convenience preview link
  version        String       @default("1.0")
  academicYear   String?
  isActive       Boolean      @default(true)
  sourcePriority Int          @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board   Board?   @relation(fields: [boardId], references: [id])
  stream  Stream?  @relation(fields: [streamId], references: [id])
  class   Class?   @relation(fields: [classId], references: [id])
  subject Subject? @relation(fields: [subjectId], references: [id])
  unit    Unit?    @relation(fields: [unitId], references: [id])
  chapter Chapter? @relation(fields: [chapterId], references: [id])
  topic   Topic?   @relation(fields: [topicId], references: [id])
}

// QUESTION MODELS


model DiagramRegistry {
  id               String   @id @default(uuid())
  title            String
  caption          String?
  imageUrl         String   // Authoritative figure or diagram URL
  subjectId        String
  chapterId        String?
  topicId          String?
  tags             String[] // e.g. ["human_heart", "anatomy", "circuit_diagram"]
  isActive         Boolean  @default(true)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subject          Subject  @relation(fields: [subjectId], references: [id])
  chapter          Chapter? @relation(fields: [chapterId], references: [id])
  topic            Topic?   @relation(fields: [topicId], references: [id])

  questions        Question[]

  @@index([subjectId])
  @@index([chapterId])
}

model Question {
  id           String       @id @default(uuid())
  questionText String
  marks        Int
  difficulty   Difficulty
  questionType QuestionType @default(SHORT)
  chapterId    String
  topicId      String?
  options      Json?        // for MCQ choices
  answerKey    String?      // correct answer or explanation
  imageUrl     String?      // direct or override image URL
  diagramId    String?      // linked authoritative diagram from DiagramRegistry

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapter        Chapter                @relation(fields: [chapterId], references: [id])
  topic          Topic?                 @relation(fields: [topicId], references: [id])
  diagram        DiagramRegistry?       @relation(fields: [diagramId], references: [id])
  questionPapers QuestionPaperQuestion[]
}

model QuestionPaper {
  id             String      @id @default(uuid())
  title          String
  totalMarks     Int
  durationMins   Int         
  instructions   String?
  difficulty     Difficulty
  status         PaperStatus @default(DRAFT)
  patternMode    PatternMode @default(CUSTOM)
  board          String?     // e.g. "Maharashtra State Board"
  patternVersion String?     // e.g. "2024 Reference Pattern"
  patternData    Json?       // Full pattern snapshot at generation time
  teacherId      String
  subjectId      String
  templateId     String?
  isDeleted      Boolean     @default(false)
  driveFileId    String?     // Authoritative Google Drive PDF reference
  pdfUrl         String?     // Optional convenience download link
  llmProvider    String?     // Audit metadata (e.g. "gemini", "groq", "ollama")
  llmModel       String?     // Audit metadata (e.g. "gemini-1.5-flash", "openai/gpt-oss-20b")
  generatedAt    DateTime?   // Audit metadata

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher     Teacher                @relation(fields: [teacherId], references: [id])
  subject     Subject                @relation(fields: [subjectId], references: [id])
  template    Template?              @relation(fields: [templateId], references: [id])
  questions   QuestionPaperQuestion[]
  examResults ExamResult[]

  @@index([teacherId])
  @@index([subjectId])
  @@index([status])
}

// CUSTOM PATTERN MODEL

model CustomPattern {
  id           String      @id @default(uuid())
  name         String
  teacherId    String
  totalMarks   Int
  durationMins Int
  patternData  Json        // Stores custom section configurations

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@index([teacherId])
}

// MANY TO MANY QUESTION RELATION


model QuestionPaperQuestion {
  id              String @id @default(uuid())
  questionPaperId String
  questionId      String

  createdAt DateTime @default(now())

  questionPaper QuestionPaper @relation(fields: [questionPaperId], references: [id])
  question      Question      @relation(fields: [questionId], references: [id])

  @@unique([questionPaperId, questionId])
}

// EXAM RESULT MODEL


model ExamResult {
  id              String   @id @default(uuid())
  teacherId       String
  studentId       String
  questionPaperId String
  obtainedMarks   Float
  examDate        DateTime //when the exam was held
  examType        String
  semester        Int
  academicYear    String
  isPassed        Boolean  @default(true)
  remarks         String?


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher       Teacher       @relation(fields: [teacherId], references: [id])
  student       Student       @relation(fields: [studentId], references: [id])
  questionPaper QuestionPaper @relation(fields: [questionPaperId], references: [id])

  @@unique([studentId, questionPaperId])
  @@index([studentId])
  @@index([questionPaperId])
  @@index([semester])
  @@index([academicYear])
}

// SEMESTER RESULT MODEL


model SemesterResult {
  id            String @id @default(uuid())
  studentId     String
  semester      Int
  academicYear  String
  sgpa          Float
  cgpa          Float
  totalCredits  Float
  earnedCredits Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, semester, academicYear])
  @@index([studentId])
}

// TEMPLATE MODEL


model Template {
  id      String @id @default(uuid())
  name    String @unique
  pattern Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questionPapers QuestionPaper[]
}

