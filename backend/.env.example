# Environment
NODE_ENV="development"
PORT=5000

# PostgreSQL connection string, for example:
# postgresql://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_db?schema=public"

# Use a long random value in production.
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-12345"

# Required for AI question-generation features.
GROQ_API_KEY="your-groq-api-key"

# School Information
SCHOOL_NAME="SHREE SIDDHESHWAR MAHAVIDYALAYA"
SCHOOL_ADDRESS="TAL. MAJALGAON, DIST. BEED, MAHARASHTRA - 431131"
SCHOOL_PHONE="1234567890"
SCHOOL_EMAIL="school@example.com"
SCHOOL_WEBSITE="https://example.com"

# ChromaDB configuration
CHROMA_HOST="localhost"
CHROMA_PORT="8000"
CHROMA_SSL="false"

# CORS Configuration
CORS_ORIGIN="*"

# Database credentials for Docker
DB_USER="postgres"
DB_PASSWORD="postgres"
DB_NAME="school_db"
