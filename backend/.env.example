# =================================================================
# QPGen Backend Environment Configuration (.env.example)
# Copy this file to .env and populate actual production/dev values.
# =================================================================

# Server & Database Configuration
NODE_ENV="development"
PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_db?schema=public"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-12345"

# Multi-Provider LLM Engine Configuration
# Available options: "gemini" (1M TPM), "groq", "ollama" (Local/Remote)
LLM_PROVIDER="groq"

# Google Gemini API Configuration (Recommended Cloud Provider)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Groq Cloud API Configuration
GROQ_API_KEY="gsk_placeholder_key"
GROQ_MODEL="openai/gpt-oss-20b"

# Ollama Configuration (100% Free Local Execution)
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3:8b"

# Google Drive Storage Integration Credentials (College Business Account)
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# Service Account Authentication (Recommended for Production Server)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# OAuth 2.0 Client Authentication (Alternative)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# Vector Database (ChromaDB) Configuration
CHROMA_HOST="localhost"
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_AUTH_TOKEN=""

# Institutional Branding & Metadata
SCHOOL_NAME="Shree Siddheshwar Mahavidyalaya"
SCHOOL_ADDRESS="Majalgaon, Taluka: Majalgaon, District: Beed, Maharashtra-431131"
SCHOOL_PHONE="+91 2443 235475"
SCHOOL_EMAIL="ssmmajalgaon1@gmail.com"
SCHOOL_WEBSITE="ssmm.ac.in"

# CORS Configuration
CORS_ORIGIN="*"
